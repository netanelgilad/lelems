{
  "name": "lelems",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lelems-db --local && npm run db:seed:local",
    "db:seed:local": "wrangler d1 execute lelems-db --local --file=./seeds/local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply lelems-db --remote",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "latest",
    "ai": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
